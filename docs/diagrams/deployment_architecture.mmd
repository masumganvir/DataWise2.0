            RedisInstance[("Redis (Port 6379) / In-Memory Cache")]
            LocalStorage["Local File Storage (`artifacts/`, `datasets/`)"]
        end
    end

    subgraph "External Cloud Services (Optional / Managed)"
        CloudLLM["Cloud LLM Providers (Google Gemini / Groq / Cloudflare)"]
        CloudStorage["S3 / MinIO / Supabase Storage (Port 9000 / HTTPS)"]
        ClerkSSO["Clerk / Supabase Authentication Services"]
    end

