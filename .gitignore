*.csv
*.tsv
*.parquet
*.xlsx
*.xls
*.jsonl
datasets/**
!datasets/.gitkeep
backend/data/uploads/**
!backend/data/uploads/.gitkeep
data/**
!data/.gitkeep

# ──────────────────────────────────────────────────────────────
# Machine Learning Models & Checkpoints (Stored in DB/Storage)
# ──────────────────────────────────────────────────────────────
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.bin
*.model
models/**
!models/.gitkeep
model_pipeline.pkl

# ──────────────────────────────────────────────────────────────
