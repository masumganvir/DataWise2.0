# DataWise runtime data (never commit)
data/uploads/*
!data/uploads/.gitkeep
artifacts/plots/*
!artifacts/plots/.gitkeep
artifacts/reports/*
!artifacts/reports/.gitkeep
artifacts/code/*
!artifacts/code/.gitkeep

# Database
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

